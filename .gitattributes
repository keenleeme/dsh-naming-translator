# Normalize to LF in the repository so Windows checkouts do not flip the whole
# tree on every commit. Markdown and YAML survive CRLF, but the plugin's own
# files are read as text by the Host loader, and a mixed tree makes review noise.
* text=auto eol=lf

# Images are binary.
*.svg text eol=lf
*.png binary
*.jpg binary
*.webp binary
